# SSH config TEMPLATE
#
# This file is NOT stowed. Symlinking ~/.ssh/config into a git repo can trip
# SSH's strict permission checks and clobber a working config, so copy it
# manually and edit in place:
#
#   cp ~/dotfiles/ssh/.ssh/config.template ~/.ssh/config
#   chmod 600 ~/.ssh/config
#
# No private keys are in this repo. On a new machine either copy
# ~/.ssh/id_ed25519* across from the old one, or generate fresh keys and add
# the public halves to the corresponding GitHub accounts:
#
#   ssh-keygen -t ed25519 -C "you@example.com"        -f ~/.ssh/id_ed25519
#   ssh-keygen -t ed25519 -C "hrithikt1999@gmail.com" -f ~/.ssh/id_ed25519_personal
#
# Two GitHub accounts are kept apart by host alias rather than by juggling
# `gh auth switch` — the alias decides which key is offered, so pushes are
# deterministic. Always clone/remote via the alias, never bare
# git@github.com:, which picks whichever key ssh happens to try first.

# --- Work GitHub ------------------------------------------------------------
# Rename this alias to match the employer, and update remotes to match:
#   git remote set-url origin git@github-work:<org>/<repo>.git
Host github-work
  HostName github.com
  User git
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519

# --- Personal GitHub --------------------------------------------------------
#   git remote set-url origin git@github-personal:hrithikt/<repo>.git
Host github-personal
  HostName github.com
  User git
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519_personal

# Verify routing after setup:
#   ssh -T git@github-work       # -> Hi <work-username>!
#   ssh -T git@github-personal   # -> Hi hrithikt!

# --- Machine-local additions ------------------------------------------------
# Tools that inject their own SSH config (OrbStack, Tailscale, cloud SDKs) add
# an Include line at the very TOP of ~/.ssh/config, above any Host block.
# Those are machine-specific and intentionally not templated here.
